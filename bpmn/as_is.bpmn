<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_as_is" targetNamespace="https://example.org/bpmn/process-automation-lab"><ns0:process id="as_is_process" name="Conferência documental AS-IS" isExecutable="false"><ns0:documentation>Modelo sintético gerado pelo Business Process Automation Lab. AS-IS descoberto de log de eventos; TO-BE com automação - simulação, sem operação real.</ns0:documentation><ns0:laneSet id="laneSet_as_is"><ns0:lane id="lane_as_is_triagem" name="Operação"><ns0:flowNodeRef>triagem</ns0:flowNodeRef><ns0:flowNodeRef>conferencia</ns0:flowNodeRef><ns0:flowNodeRef>correcao</ns0:flowNodeRef></ns0:lane><ns0:lane id="lane_as_is_aprovacao" name="Gestão"><ns0:flowNodeRef>aprovacao</ns0:flowNodeRef><ns0:flowNodeRef>lancamento</ns0:flowNodeRef></ns0:lane></ns0:laneSet><ns0:startEvent id="start" name="Recebimento do documento" /><ns0:userTask id="triagem" name="Triagem manual" /><ns0:userTask id="conferencia" name="Conferência manual" /><ns0:exclusiveGateway id="gateway" name="Divergência?" gatewayDirection="Diverging" /><ns0:userTask id="correcao" name="Correção" /><ns0:userTask id="aprovacao" name="Aprovação" /><ns0:userTask id="lancamento" name="Lançamento" /><ns0:endEvent id="end" name="Documento lançado" /><ns0:sequenceFlow id="flow_1_start_triagem" sourceRef="start" targetRef="triagem" /><ns0:sequenceFlow id="flow_2_triagem_conferencia" sourceRef="triagem" targetRef="conferencia" /><ns0:sequenceFlow id="flow_3_conferencia_gateway" sourceRef="conferencia" targetRef="gateway" /><ns0:sequenceFlow id="flow_4_gateway_correcao" sourceRef="gateway" targetRef="correcao" name="sim (divergência)" /><ns0:sequenceFlow id="flow_5_correcao_aprovacao" sourceRef="correcao" targetRef="aprovacao" /><ns0:sequenceFlow id="flow_6_aprovacao_lancamento" sourceRef="aprovacao" targetRef="lancamento" /><ns0:sequenceFlow id="flow_7_lancamento_end" sourceRef="lancamento" targetRef="end" /><ns0:sequenceFlow id="flow_sem_divergencia" sourceRef="gateway" targetRef="aprovacao" name="não" /></ns0:process></ns0:definitions>