<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_to_be" targetNamespace="https://example.org/bpmn/process-automation-lab"><ns0:process id="to_be_process" name="Conferência documental TO-BE (com automação)" isExecutable="false"><ns0:documentation>Modelo sintético gerado pelo Business Process Automation Lab. AS-IS descoberto de log de eventos; TO-BE com automação - simulação, sem operação real.</ns0:documentation><ns0:laneSet id="laneSet_to_be"><ns0:lane id="lane_to_be_extracao" name="Automação (API)"><ns0:flowNodeRef>extracao</ns0:flowNodeRef><ns0:flowNodeRef>validacao</ns0:flowNodeRef><ns0:flowNodeRef>lancamento</ns0:flowNodeRef></ns0:lane><ns0:lane id="lane_to_be_conferencia" name="Operação (exceção)"><ns0:flowNodeRef>conferencia</ns0:flowNodeRef><ns0:flowNodeRef>correcao</ns0:flowNodeRef></ns0:lane><ns0:lane id="lane_to_be_aprovacao" name="Gestão"><ns0:flowNodeRef>aprovacao</ns0:flowNodeRef></ns0:lane></ns0:laneSet><ns0:startEvent id="start" name="Recebimento do documento" /><ns0:serviceTask id="extracao" name="Extração automática (API)"><ns0:extensionElements /></ns0:serviceTask><ns0:serviceTask id="validacao" name="Validação por regras (automática)"><ns0:extensionElements /></ns0:serviceTask><ns0:exclusiveGateway id="gateway" name="Divergência?" gatewayDirection="Diverging" /><ns0:userTask id="conferencia" name="Conferência humana (exceção)" /><ns0:userTask id="correcao" name="Correção" /><ns0:userTask id="aprovacao" name="Aprovação humana" /><ns0:serviceTask id="lancamento" name="Lançamento automático (API)"><ns0:extensionElements /></ns0:serviceTask><ns0:endEvent id="end" name="Documento lançado" /><ns0:sequenceFlow id="flow_1_start_extracao" sourceRef="start" targetRef="extracao" /><ns0:sequenceFlow id="flow_2_extracao_validacao" sourceRef="extracao" targetRef="validacao" /><ns0:sequenceFlow id="flow_3_validacao_gateway" sourceRef="validacao" targetRef="gateway" /><ns0:sequenceFlow id="flow_4_gateway_conferencia" sourceRef="gateway" targetRef="conferencia" /><ns0:sequenceFlow id="flow_5_conferencia_correcao" sourceRef="conferencia" targetRef="correcao" /><ns0:sequenceFlow id="flow_6_correcao_aprovacao" sourceRef="correcao" targetRef="aprovacao" /><ns0:sequenceFlow id="flow_7_aprovacao_lancamento" sourceRef="aprovacao" targetRef="lancamento" /><ns0:sequenceFlow id="flow_8_lancamento_end" sourceRef="lancamento" targetRef="end" /><ns0:sequenceFlow id="flow_sem_divergencia" sourceRef="gateway" targetRef="aprovacao" name="não" /></ns0:process></ns0:definitions>