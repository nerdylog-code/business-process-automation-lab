<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_to_be" targetNamespace="https://example.org/bpmn/process-automation-lab"><ns0:process id="to_be_process" name="Conferência documental TO-BE (com automação)" isExecutable="false"><ns0:documentation>Modelo de destino proposto (não descoberto): extração e validação automáticas, conferência humana apenas na exceção, aprovação sempre humana e lançamento automatizado.</ns0:documentation><ns0:laneSet id="laneSet_to_be"><ns0:lane id="lane_to_be_0" name="Automação (API)"><ns0:flowNodeRef>extracao</ns0:flowNodeRef><ns0:flowNodeRef>validacao</ns0:flowNodeRef><ns0:flowNodeRef>lancamento</ns0:flowNodeRef></ns0:lane><ns0:lane id="lane_to_be_1" name="Operação (exceção)"><ns0:flowNodeRef>conferencia</ns0:flowNodeRef><ns0:flowNodeRef>correcao</ns0:flowNodeRef></ns0:lane><ns0:lane id="lane_to_be_2" name="Gestão"><ns0:flowNodeRef>aprovacao</ns0:flowNodeRef></ns0:lane></ns0:laneSet><ns0:startEvent id="start" name="Recebimento do documento" /><ns0:serviceTask id="extracao" name="Extração automática (API)"><ns0:extensionElements /></ns0:serviceTask><ns0:serviceTask id="validacao" name="Validação por regras (automática)"><ns0:extensionElements /></ns0:serviceTask><ns0:exclusiveGateway id="gateway_div" name="Divergência?" gatewayDirection="Diverging" /><ns0:userTask id="conferencia" name="Conferência humana (exceção)" /><ns0:userTask id="correcao" name="Correção" /><ns0:userTask id="aprovacao" name="Aprovação humana" /><ns0:serviceTask id="lancamento" name="Lançamento automático (API)"><ns0:extensionElements /></ns0:serviceTask><ns0:endEvent id="end" name="Documento lançado" /><ns0:sequenceFlow id="flow_to_be_1_start_extracao" sourceRef="start" targetRef="extracao" /><ns0:sequenceFlow id="flow_to_be_2_extracao_validacao" sourceRef="extracao" targetRef="validacao" /><ns0:sequenceFlow id="flow_to_be_3_validacao_gateway_div" sourceRef="validacao" targetRef="gateway_div" /><ns0:sequenceFlow id="flow_to_be_4_gateway_div_conferencia" sourceRef="gateway_div" targetRef="conferencia" name="sim (divergência)" /><ns0:sequenceFlow id="flow_to_be_5_conferencia_correcao" sourceRef="conferencia" targetRef="correcao" /><ns0:sequenceFlow id="flow_to_be_6_correcao_aprovacao" sourceRef="correcao" targetRef="aprovacao" /><ns0:sequenceFlow id="flow_to_be_7_gateway_div_aprovacao" sourceRef="gateway_div" targetRef="aprovacao" name="não (aprovado automaticamente)" /><ns0:sequenceFlow id="flow_to_be_8_aprovacao_lancamento" sourceRef="aprovacao" targetRef="lancamento" /><ns0:sequenceFlow id="flow_to_be_9_lancamento_end" sourceRef="lancamento" targetRef="end" /></ns0:process><ns1:BPMNDiagram id="BPMNDiagram_to_be"><ns1:BPMNPlane id="BPMNPlane_to_be" bpmnElement="to_be_process"><ns1:BPMNShape id="start_gui" bpmnElement="start"><ns2:Bounds x="160" y="120" width="36" height="36" /></ns1:BPMNShape><ns1:BPMNShape id="extracao_gui" bpmnElement="extracao"><ns2:Bounds x="350" y="120" width="100" height="80" /></ns1:BPMNShape><ns1:BPMNShape id="validacao_gui" bpmnElement="validacao"><ns2:Bounds x="540" y="120" width="100" height="80" /></ns1:BPMNShape><ns1:BPMNShape id="gateway_div_gui" bpmnElement="gateway_div"><ns2:Bounds x="730" y="120" width="36" height="36" /></ns1:BPMNShape><ns1:BPMNShape id="conferencia_gui" bpmnElement="conferencia"><ns2:Bounds x="920" y="120" width="100" height="80" /></ns1:BPMNShape><ns1:BPMNShape id="correcao_gui" bpmnElement="correcao"><ns2:Bounds x="1110" y="120" width="100" height="80" /></ns1:BPMNShape><ns1:BPMNShape id="aprovacao_gui" bpmnElement="aprovacao"><ns2:Bounds x="1300" y="120" width="100" height="80" /></ns1:BPMNShape><ns1:BPMNShape id="lancamento_gui" bpmnElement="lancamento"><ns2:Bounds x="1490" y="120" width="100" height="80" /></ns1:BPMNShape><ns1:BPMNShape id="end_gui" bpmnElement="end"><ns2:Bounds x="1680" y="120" width="36" height="36" /></ns1:BPMNShape><ns1:BPMNEdge id="flow_to_be_1_start_extracao_gui" bpmnElement="flow_to_be_1_start_extracao"><ns3:waypoint x="260" y="160" /><ns3:waypoint x="350" y="160" /></ns1:BPMNEdge><ns1:BPMNEdge id="flow_to_be_2_extracao_validacao_gui" bpmnElement="flow_to_be_2_extracao_validacao"><ns3:waypoint x="450" y="160" /><ns3:waypoint x="540" y="160" /></ns1:BPMNEdge><ns1:BPMNEdge id="flow_to_be_3_validacao_gateway_div_gui" bpmnElement="flow_to_be_3_validacao_gateway_div"><ns3:waypoint x="640" y="160" /><ns3:waypoint x="730" y="160" /></ns1:BPMNEdge><ns1:BPMNEdge id="flow_to_be_4_gateway_div_conferencia_gui" bpmnElement="flow_to_be_4_gateway_div_conferencia"><ns3:waypoint x="830" y="160" /><ns3:waypoint x="920" y="160" /></ns1:BPMNEdge><ns1:BPMNEdge id="flow_to_be_5_conferencia_correcao_gui" bpmnElement="flow_to_be_5_conferencia_correcao"><ns3:waypoint x="1020" y="160" /><ns3:waypoint x="1110" y="160" /></ns1:BPMNEdge><ns1:BPMNEdge id="flow_to_be_6_correcao_aprovacao_gui" bpmnElement="flow_to_be_6_correcao_aprovacao"><ns3:waypoint x="1210" y="160" /><ns3:waypoint x="1300" y="160" /></ns1:BPMNEdge><ns1:BPMNEdge id="flow_to_be_7_gateway_div_aprovacao_gui" bpmnElement="flow_to_be_7_gateway_div_aprovacao"><ns3:waypoint x="830" y="160" /><ns3:waypoint x="1300" y="160" /></ns1:BPMNEdge><ns1:BPMNEdge id="flow_to_be_8_aprovacao_lancamento_gui" bpmnElement="flow_to_be_8_aprovacao_lancamento"><ns3:waypoint x="1400" y="160" /><ns3:waypoint x="1490" y="160" /></ns1:BPMNEdge><ns1:BPMNEdge id="flow_to_be_9_lancamento_end_gui" bpmnElement="flow_to_be_9_lancamento_end"><ns3:waypoint x="1590" y="160" /><ns3:waypoint x="1680" y="160" /></ns1:BPMNEdge></ns1:BPMNPlane></ns1:BPMNDiagram></ns0:definitions>